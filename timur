    // TASK 3: Генератор таблицы
    // ==========================================

    const generateTableBtn = document.getElementById('generateTableBtn');
    const tableContainer = document.getElementById('tableContainer');
    const colorPicker = document.getElementById('colorPicker');
    const countColorBtn = document.getElementById('countColorBtn');
    const colorCountResult = document.getElementById('colorCountResult');

    function generateTable(rows, cols) {
      tableContainer.innerHTML = '';
      colorCountResult.textContent = '';

      const table = document.createElement('table');

      for (let i = 0; i < rows; i++) {
        const tr = document.createElement('tr');
        for (let j = 0; j < cols; j++) {
          const td = document.createElement('td');
          
          // Клик по ячейке сменяет цвет
          td.addEventListener('click', function() {
            const selectedColor = colorPicker.value;
            if (this.dataset.color === selectedColor) {
              this.style.backgroundColor = '';
              delete this.dataset.color;
            } else {
              this.style.backgroundColor = selectedColor;
              this.dataset.color = selectedColor;
            }
          });

          tr.appendChild(td);
        }
        table.appendChild(tr);
      }

      tableContainer.appendChild(table);
    }

    function countCellsByColor(color) {
      const cells = tableContainer.querySelectorAll('td');
      let count = 0;
      cells.forEach(cell => {
        if (cell.dataset.color === color) {
          count++;
        }
      });
      return count;
    }

    generateTableBtn.addEventListener('click', () => {
      const rows = parseInt(document.getElementById('rowsInput').value) || 1;
      const cols = parseInt(document.getElementById('colsInput').value) || 1;
      generateTable(rows, cols);
    });

    countColorBtn.addEventListener('click', () => {
      const selectedColor = colorPicker.value;
      const count = countCellsByColor(selectedColor);
      const colorName = colorPicker.options[colorPicker.selectedIndex].text;
      colorCountResult.textContent = `Количество ячеек цвета "${colorName}": ${count}`;
    });

    // Создаем начальную таблицу 4x4
    generateTable(4, 4);
